{
  "name": "cross-platform-tasks-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "node scripts/build-e2e.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test --headed",
    "test:e2e:playwright": "playwright test",
    "test:poc:playwright": "playwright test --config playwright.poc.config.ts",
    "test:poc:selenium": "node --test --test-concurrency=1 e2e/pocs/selenium/web.test.ts",
    "test:poc:web": "node scripts/run-pocs.mjs web",
    "test:poc:pwa": "node scripts/run-pocs.mjs pwa",
    "test:poc:electron": "node scripts/run-pocs.mjs electron",
    "test:poc:electron:files": "node scripts/run-electron-files-direct.mjs",
    "test:poc:electron:files:chromedriver": "node scripts/run-electron-files.mjs",
    "check:electron:mac2": "node e2e/pocs/electron-mac2-bootstrap.ts",
    "test:electron:files": "node --test electron/polygon-files.test.cjs",
    "check:satellite": "node scripts/check-satellite.mjs",
    "test:poc:android": "node scripts/run-pocs.mjs android",
    "test:poc:android:hybrid": "node scripts/run-android-hybrid.mjs",
    "test:poc:all": "node scripts/run-pocs.mjs all",
    "report:poc": "node scripts/report-pocs.mjs",
    "report:poc:check": "node scripts/verify-poc-reports.mjs",
    "test:e2e:playwright:visual": "HEADLESS=false playwright test --headed",
    "test:e2e:visual:edit": "playwright test e2e/playwright/cancel-edit.spec.ts --headed",
    "test:e2e:electron": "node scripts/run-pocs.mjs electron",
    "test:e2e:android": "node scripts/run-pocs.mjs android",
    "test:e2e:android:build": "npm run build:e2e && cap sync android && cd android && ./gradlew assembleDebug",
    "test:e2e:watch": "playwright test --ui",
    "electron:dev": "electron ./electron/main.cjs",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:build:poc": "node scripts/build-electron-poc.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "test:appium:native": "node --test e2e/pocs/shared/appium-native.test.ts"
  },
  "dependencies": {
    "@arcgis/core": "latest",
    "@capacitor/android": "latest",
    "@capacitor/core": "latest",
    "lucide": "^1.47.0"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "@electron/get": "^5.1.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "latest",
    "@types/selenium-webdriver": "^4.35.7",
    "@vitejs/plugin-basic-ssl": "latest",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "electron": "44.4.3",
    "electron-builder": "latest",
    "extract-zip": "^2.0.1",
    "selenium-webdriver": "^4.51.0",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest"
  }
}
