{
  "name": "cross-platform-tasks-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "electron:dev": "electron ./electron/main.cjs",
    "electron:build": "node scripts/build-electron.mjs",
    "android:sync": "yarn build && cap sync android",
    "android:open": "cap open android",
    "android:build": "yarn android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@arcgis/core": "latest",
    "@capacitor/android": "latest",
    "@capacitor/core": "latest",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.4.3",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest"
  }
}
